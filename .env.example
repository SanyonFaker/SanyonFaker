# ---------------------------------------------------------------------------
# ENPEI — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored and is never committed.
# ---------------------------------------------------------------------------

# --- Supabase (required to leave Demo Mode) ---------------------------------
# Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API Keys
# Newer projects call this the "publishable" key; older ones call it "anon".
# Either name works — the app reads whichever is present.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security. NEVER expose or prefix with NEXT_PUBLIC_.
# Only needed for privileged server tasks (e.g. seeding); normal admin work uses
# the signed-in user's session instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- Studio preview (Demo Mode only) ----------------------------------------
# Optional. While Supabase is unconfigured, setting this lets you sign in at
# /admin and review the dashboard locally. Any e-mail works; only this password
# is checked. It becomes unreachable the moment Supabase credentials are set.
# Leave it unset in production.
# DEMO_ADMIN_PASSWORD=

# --- Admin allow-list -------------------------------------------------------
# Comma-separated e-mail addresses allowed to reach /admin/dashboard.
# The matching accounts must exist in Supabase Auth (Authentication → Users).
ADMIN_EMAILS=you@example.com

# --- Site -------------------------------------------------------------------
# Used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage -----------------------------------------------------------------
# Public bucket that holds the original photographs.
NEXT_PUBLIC_SUPABASE_BUCKET=photos
